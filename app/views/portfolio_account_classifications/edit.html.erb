<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", name: @account.name), subtitle: t(".subtitle")) %>
  <% dialog.with_body do %>
    <%= styled_form_with model: @account, url: portfolio_account_classification_path(@account), method: :patch, class: "space-y-4", data: { turbo_frame: "_top" } do |form| %>
      <%= form.select :allocation_category,
            FamilySecurityClassification::CATEGORIES.map { |category| [ t("portfolios.allocation.categories.#{category}"), category ] },
            { label: t(".category"), include_blank: t(".default") } %>
      <p class="text-sm text-secondary"><%= t(".scope_note") %></p>
      <div class="flex justify-end gap-2">
        <%= render DS::Button.new(text: t(".cancel"), variant: :secondary, data: { action: "DS--dialog#close" }) %>
        <%= render DS::Button.new(text: t(".save"), type: :submit) %>
      </div>
    <% end %>
  <% end %>
<% end %>
