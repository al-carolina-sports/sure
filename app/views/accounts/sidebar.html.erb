<%= turbo_frame_tag "sidebar_holdings" do %>
  <div class="flex flex-col gap-3">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <h2 class="text-sm font-medium text-primary truncate"><%= @account.name %></h2>
        <% if @account.long_subtype_label.present? %>
          <p class="text-xs text-secondary truncate"><%= @account.long_subtype_label %></p>
        <% end %>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <% if preview_features_enabled? %>
          <%= render DS::Link.new(
                text: t("accounts.sidebar_holdings.classify"),
                href: edit_portfolio_account_classification_path(@account),
                variant: :ghost,
                size: :sm,
                data: { turbo_frame: "modal" }
              ) %>
        <% end %>
        <%= render DS::Link.new(
              text: t("accounts.sidebar_holdings.open_account"),
              href: account_path(@account),
              variant: :ghost,
              size: :sm,
              data: { turbo_frame: "_top" }
            ) %>
        <button type="button" class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-lg text-secondary hover:text-primary hover:bg-container-inset-hover focus-ring" data-action="sidebar-holdings#close" aria-label="<%= t("accounts.sidebar_holdings.close") %>">
          <%= icon "x", size: "sm" %>
        </button>
      </div>
    </div>

    <% if @holdings.any? || @account.cash_balance.to_d.positive? %>
      <%= render DS::Table.new(
            rows: sidebar_holding_rows(@account, @holdings),
            inset: true,
            label: t("accounts.sidebar_holdings.table_label", account: @account.name)
          ) do |table| %>
        <% table.with_column(t("accounts.sidebar_holdings.name"), row_header: true, class: "w-full max-w-0") do |row| %>
          <div class="min-w-0">
            <p class="truncate font-medium text-primary"><%= row.name %></p>
            <p class="text-xs text-secondary truncate">
              <% if row.quantity %>
                <%= t("accounts.sidebar_holdings.quantity", quantity: format_quantity(row.quantity, exact: @account.crypto?)) %>
              <% end %>
              <% if row.quantity && row.gain %>
                <span aria-hidden="true">·</span>
              <% end %>
              <% if row.gain %>
                <span class="<%= row.gain_class %>"><%= format_money(row.gain) %></span>
              <% end %>
            </p>
          </div>
        <% end %>
        <% table.with_column(t("accounts.sidebar_holdings.value"), numeric: true, class: "privacy-sensitive") do |row| %>
          <%= format_money(row.amount) %>
        <% end %>
        <% table.with_column(t("accounts.sidebar_holdings.weight"), numeric: true) do |row| %>
          <%= row.weight ? number_to_percentage(row.weight, precision: 1) : t("accounts.sidebar_holdings.not_applicable") %>
        <% end %>
      <% end %>
    <% else %>
      <div class="rounded-xl bg-container-inset px-4 py-3">
        <p class="text-xs text-secondary"><%= t("accounts.sidebar_holdings.balance") %></p>
        <p class="text-lg font-medium text-primary privacy-sensitive"><%= format_money(@account.balance_money) %></p>
      </div>

      <% if @entries.present? %>
        <%= render DS::Table.new(rows: @entries, inset: true, label: t("accounts.sidebar_holdings.recent")) do |table| %>
          <% table.with_column(t("accounts.sidebar_holdings.entry"), class: "w-full max-w-0") do |entry| %>
            <div class="min-w-0">
              <p class="truncate text-primary"><%= entry.name %></p>
              <p class="text-xs text-secondary"><%= l(entry.date, format: :short) %></p>
            </div>
          <% end %>
          <% table.with_column(t("accounts.sidebar_holdings.value"), numeric: true, class: "privacy-sensitive") do |entry| %>
            <%= format_money(entry.amount_money) %>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-sm text-secondary"><%= t("accounts.sidebar_holdings.no_activity") %></p>
      <% end %>
    <% end %>
  </div>
<% end %>
